# Azure Speech iOS SDK is distributed as a dynamic framework — keep use_frameworks enabled.
platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run `flutter pub get` in the project root first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Run `flutter pub get`."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Azure Speech pods (and transitive deps) may ship with a lower declared
      # IPHONEOS_DEPLOYMENT_TARGET than our app; align to the Podfile floor to
      # avoid Xcode warnings and stale SDK compatibility flags.
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end

  # media_kit ships xcframeworks with an ios-arm64_x86_64-simulator slice; on
  # Apple Silicon the simulator runs arm64, but Flutter-generated
  # EXCLUDED_ARCHS[sdk=iphonesimulator*]=i386 arm64 removes that slice, so the
  # Runner can't link for simulator. Re-scope the exclusion to legacy i386
  # only so the simulator can use the arm64 slice at native speed.
  installer.aggregate_targets.each do |aggregate|
    aggregate.user_project.native_targets.each do |native_target|
      native_target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
      end
    end
    aggregate.user_project.save
  end
end
